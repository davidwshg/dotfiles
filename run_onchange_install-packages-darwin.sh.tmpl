#!/bin/bash
# Hash triggers re-run when Brewfile changes:
# {{ include "dot_Brewfile.tmpl" | sha256sum }}
set -euo pipefail

export PATH="/opt/homebrew/bin:$PATH"

command -v brew >/dev/null 2>&1 || exit 0

if ! brew bundle install --global --no-upgrade; then
  echo "Warning: one or more Homebrew packages/casks failed to install — see output above. Continuing setup." >&2
fi
